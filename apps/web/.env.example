# Pantheon Web Client Environment Configuration

# Backend API Base URL (defaults to http://localhost:3000 in local dev)
# In production, set to your deployed backend origin (e.g., https://api.pantheon.dev)
VITE_API_BASE_URL=http://localhost:3000

# Optional custom CDN/Assets Base URL (if serving media from a separate CDN/bucket domain)
# If omitted, uploads resolve via VITE_API_BASE_URL or relative same-origin paths
# VITE_ASSETS_BASE_URL=https://cdn.pantheon.dev
