DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
BUILD_RUNNER_BOOTSTRAP_SECRET="your-runner-bootstrap-secret"
BUILD_ARTIFACT_MAX_SIZE_MB="500"

# Authentication & Tokens
AUTH_JWT_SECRET="your-secure-random-jwt-secret"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
ENABLE_DEMO_SEED="false"

# Gmail SMTP Email Delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
MAIL_FROM="Pantheon <no-reply@pantheon.dev>"

# Media Storage Architecture
# 'local' for development (stored in apps/api/uploads)
# 's3' or 'r2' for production object storage (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER="local"
S3_BUCKET="pantheon-media"
S3_REGION="auto"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_PUBLIC_URL="https://cdn.pantheon.dev"