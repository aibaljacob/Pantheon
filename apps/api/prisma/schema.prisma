generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  username                String                   @unique
  email                   String                   @unique
  passwordHash            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  role                    Role                     @default(USER)
  refreshTokenVersion     Int                      @default(1)
  provider                AuthProvider             @default(LOCAL)
  providerId              String?                  @unique
  emailVerified           Boolean                  @default(false)
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  following               UserFollow[]             @relation("Following")
  followers               UserFollow[]             @relation("Followers")
  profile                 UserProfile?
  foundedProjects         Project[]                @relation("FoundedProjects")
  projectMemberships      ProjectMember[]
  sentInvitations         ProjectInvitation[]      @relation("SentInvitations")
  receivedInvitations     ProjectInvitation[]      @relation("ReceivedInvitations")
  repoCommits             RepoCommit[]
  authoredPullRequests    RepoPullRequest[]        @relation("PrAuthor")
  mergedPullRequests      RepoPullRequest[]        @relation("PrMergedBy")
  repoReleases            RepoRelease[]
  applications            ProjectApplication[]     @relation("ProjectApplications")
  assignedTasks           Task[]                   @relation("AssignedTasks")
  triggeredBuilds         BuildJob[]               @relation("TriggeredBuilds")
  uploadedPlayableBuilds  PlayableBuild[]          @relation("UploadedPlayableBuilds")
}

model UserProfile {
  id              String                    @id @default(uuid())
  userId          String                    @unique
  firstName       String
  lastName        String
  displayName     String?
  avatarUrl       String?
  bannerUrl       String?
  headline        String?
  bio             String?
  location        String?
  timezone        String?
  experienceYears Int?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  availability    String?                   @default("Available for collaboration")
  education       UserEducation[]
  experiences     UserExperience[]
  links           UserLink[]
  portfolio       UserPortfolioItem[]
  identity        UserProfessionalIdentity?
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          UserResume?
}

model ProfessionalRole {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       UserRole[]
  projectRoles ProjectRole[]
}

model Specialization {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  users       UserSpecialization[]
}

model Skill {
  id           String             @id @default(uuid())
  name         String             @unique
  description  String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  users        UserSkill[]
  projectRoles ProjectRoleSkill[]
}

model Tool {
  id           String            @id @default(uuid())
  name         String            @unique
  description  String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  users        UserTool[]
  projectRoles ProjectRoleTool[]
}

model GameEngine {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserGameEngine[]
}

model Genre {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       UserGenre[]
}

model Platform {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  users       UserPlatform[]
}

model UserProfessionalIdentity {
  id              String               @id @default(uuid())
  profileId       String               @unique
  gameEngines     UserGameEngine[]
  genres          UserGenre[]
  platforms       UserPlatform[]
  profile         UserProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  roles           UserRole[]
  skills          UserSkill[]
  specializations UserSpecialization[]
  tools           UserTool[]
}

model UserRole {
  profileId String
  roleId    String
  profile   UserProfessionalIdentity @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role      ProfessionalRole         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([profileId, roleId])
  @@index([roleId])
}

model UserSpecialization {
  profileId        String
  specializationId String
  profile          UserProfessionalIdentity @relation(fields: [profileId], references: [id], onDelete: Cascade)
  specialization   Specialization           @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([profileId, specializationId])
  @@index([specializationId])
}

model UserSkill {
  profileId String
  skillId   String
  profile   UserProfessionalIdentity @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill                    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
}

model UserTool {
  profileId String
  toolId    String
  profile   UserProfessionalIdentity @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tool      Tool                     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([profileId, toolId])
  @@index([toolId])
}

model UserGameEngine {
  profileId String
  engineId  String
  engine    GameEngine               @relation(fields: [engineId], references: [id], onDelete: Cascade)
  profile   UserProfessionalIdentity @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, engineId])
  @@index([engineId])
}

model UserGenre {
  profileId String
  genreId   String
  genre     Genre                    @relation(fields: [genreId], references: [id], onDelete: Cascade)
  profile   UserProfessionalIdentity @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, genreId])
  @@index([genreId])
}

model UserPlatform {
  profileId  String
  platformId String
  platform   Platform                 @relation(fields: [platformId], references: [id], onDelete: Cascade)
  profile    UserProfessionalIdentity @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, platformId])
  @@index([platformId])
}

model UserExperience {
  id           String      @id @default(uuid())
  profileId    String
  position     String
  company      String
  location     String?
  startDate    String
  endDate      String?
  isCurrent    Boolean     @default(false)
  description  String
  technologies String[]
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model UserEducation {
  id          String      @id @default(uuid())
  profileId   String
  institution String
  degree      String
  startDate   String
  endDate     String?
  description String?
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model UserPortfolioItem {
  id           String      @id @default(uuid())
  profileId    String
  title        String
  coverUrl     String?
  description  String
  role         String
  technologies String[]
  tools        String[]    @default([])
  gameEngine   String
  genre        String
  platform     String
  status       String      @default("Prototype")
  projectUrl   String?
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model UserResume {
  id          String      @id @default(uuid())
  profileId   String      @unique
  fileName    String
  fileType    String
  fileSize    String
  downloadUrl String?
  visibility  String      @default("Public")
  updatedAt   DateTime    @updatedAt
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model UserLink {
  id          String      @id @default(uuid())
  profileId   String
  platform    String
  displayName String
  url         String
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model AuthSession {
  id           String   @id @default(uuid())
  accessToken  String   @unique
  refreshToken String   @unique
  rememberMe   Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  USER
  ADMINISTRATOR
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ProjectStatus {
  PLANNING
  PRE_PRODUCTION
  PROTOTYPE
  IN_DEVELOPMENT
  ALPHA
  BETA
  COMPLETED
  PAUSED
}

enum ProjectModerationStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model Project {
  id               String                  @id @default(uuid())
  name             String
  slug             String                  @unique
  description      String
  coverUrl         String?
  status           ProjectStatus           @default(IN_DEVELOPMENT)
  moderationStatus ProjectModerationStatus @default(PENDING_REVIEW)
  genre            String?
  platform         String?
  gameEngine       String?
  founderId        String
  savedAiRecommendations Json?
  savedTalentRecommendations Json?
  repositoryData         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  founder          User                    @relation("FoundedProjects", fields: [founderId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  openRoles        ProjectRole[]
  invitations      ProjectInvitation[]
  repository       ProjectRepository?
  applications     ProjectApplication[]
  milestones       Milestone[]
  tasks            Task[]
  buildJobs        BuildJob[]
  playableBuilds   PlayableBuild[]

  @@index([founderId])
  @@index([moderationStatus])
}

enum ProjectMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

model ProjectMember {
  id            String              @id @default(uuid())
  projectId     String
  userId        String
  role          String              @default("Member")
  projectRoleId String?
  status        ProjectMemberStatus @default(ACTIVE)
  joinedAt      DateTime            @default(now())
  leftAt        DateTime?
  updatedAt     DateTime            @default(now()) @updatedAt
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole   ProjectRole?        @relation("PrimaryProjectRole", fields: [projectRoleId], references: [id], onDelete: SetNull)
  assignedRoles ProjectRole[]       @relation("AssignedProjectRoles")

  @@unique([projectId, userId])
  @@index([projectId, status])
  @@index([userId, status])
  @@index([projectRoleId])
}

enum ProjectRoleStatus {
  OPEN
  IN_REVIEW
  FILLED
  CLOSED
}

enum ProjectRoleCommitment {
  FULL_TIME
  PART_TIME
  CONTRACT
  REV_SHARE
}

enum ProjectRoleExperienceLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
}

model ProjectRole {
  id               String                       @id @default(uuid())
  projectId        String
  roleId           String
  title            String?
  description      String?
  experienceLevel  ProjectRoleExperienceLevel   @default(MID)
  commitment       ProjectRoleCommitment        @default(PART_TIME)
  status           ProjectRoleStatus            @default(OPEN)
  assignedMemberId String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  project          Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role             ProfessionalRole             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedMember   ProjectMember?               @relation("AssignedProjectRoles", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  requiredSkills   ProjectRoleSkill[]
  requiredTools    ProjectRoleTool[]
  invitations      ProjectInvitation[]
  applications     ProjectApplication[]
  primaryMembers   ProjectMember[]              @relation("PrimaryProjectRole")

  @@index([projectId])
  @@index([roleId])
  @@index([assignedMemberId])
  @@index([status])
}

model ProjectRoleSkill {
  projectRoleId String
  skillId       String

  projectRole   ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectRoleId, skillId])
  @@index([skillId])
}

model ProjectRoleTool {
  projectRoleId String
  toolId        String

  projectRole   ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)
  tool          Tool        @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([projectRoleId, toolId])
  @@index([toolId])
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model ProjectInvitation {
  id            String                  @id @default(uuid())
  projectId     String
  projectRoleId String
  inviterId     String
  inviteeId     String
  status        ProjectInvitationStatus @default(PENDING)
  message       String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRole ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)
  inviter     User        @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User        @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectRoleId])
  @@index([inviterId])
  @@index([inviteeId])
  @@index([status])
}

model ProjectRepository {
  id            String              @id @default(uuid())
  projectId     String              @unique
  defaultBranch String              @default("main")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branches      RepoBranch[]
  commits       RepoCommit[]
  files         RepoFile[]
  pullRequests  RepoPullRequest[]
  releases      RepoRelease[]

  @@index([projectId])
}

model RepoBranch {
  id           String            @id @default(uuid())
  repositoryId String
  name         String
  isDefault    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  repository   ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  files        RepoFile[]

  @@unique([repositoryId, name])
  @@index([repositoryId])
}

model RepoCommit {
  id           String            @id @default(uuid())
  repositoryId String
  hash         String            @unique
  message      String
  branchName   String
  authorId     String
  changedFiles String[]          @default([])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  repository   ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  files        RepoFile[]

  @@index([repositoryId])
  @@index([authorId])
  @@index([hash])
  @@index([branchName])
}

model RepoFile {
  id           String            @id @default(uuid())
  repositoryId String
  branchId     String
  path         String
  content      String            @db.Text
  size         Int
  linesCount   Int
  lastCommitId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  repository   ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  branch       RepoBranch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lastCommit   RepoCommit?       @relation(fields: [lastCommitId], references: [id], onDelete: SetNull)

  @@unique([branchId, path])
  @@index([repositoryId])
  @@index([branchId])
  @@index([path])
}

enum RepoPullRequestStatus {
  OPEN
  MERGED
  CLOSED
}

model RepoPullRequest {
  id           String                @id @default(uuid())
  repositoryId String
  number       Int
  title        String
  description  String?
  sourceBranch String
  targetBranch String
  status       RepoPullRequestStatus @default(OPEN)
  authorId     String
  mergedById   String?
  mergedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  repository   ProjectRepository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author       User                  @relation("PrAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mergedBy     User?                 @relation("PrMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([authorId])
  @@index([status])
}

model RepoRelease {
  id           String            @id @default(uuid())
  repositoryId String
  tagName      String
  title        String
  description  String?
  targetBranch String            @default("main")
  authorId     String
  assets       Json?             @default("[]")
  publishedAt  DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  repository   ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, tagName])
  @@index([repositoryId])
  @@index([authorId])
}

enum ProjectApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model ProjectApplication {
  id            String                   @id @default(uuid())
  projectId     String
  projectRoleId String
  applicantId   String
  message       String?
  status        ProjectApplicationStatus @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRole ProjectRole @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)
  applicant   User        @relation("ProjectApplications", fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectRoleId])
  @@index([applicantId])
  @@index([status])
  @@index([applicantId, projectRoleId, status])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  buildJobs   BuildJob[]
  playableBuilds PlayableBuild[]

  @@index([projectId])
  @@index([isCompleted])
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  milestoneId String?
  taskNumber  Int
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([projectId, taskNumber])
  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum BuildPlatform {
  WINDOWS
  MAC
  LINUX
  WEBGL
}

model BuildRunner {
  id         String        @id @default(uuid())
  name       String
  tokenHash  String
  platform   BuildPlatform
  isOnline   Boolean       @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  buildJobs  BuildJob[]

  @@index([platform])
  @@index([isOnline])
}

model BuildJob {
  id             String         @id @default(uuid())
  projectId      String
  buildRunnerId  String?
  commitHash     String?
  branchName     String?
  targetPlatform BuildPlatform
  status         BuildStatus    @default(QUEUED)
  triggeredById  String
  milestoneId    String?
  buildLogs      String?        @db.Text
  errorMessage   String?        @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildRunner    BuildRunner?   @relation(fields: [buildRunnerId], references: [id], onDelete: SetNull)
  triggeredBy    User           @relation("TriggeredBuilds", fields: [triggeredById], references: [id], onDelete: Cascade)
  milestone      Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  playableBuilds PlayableBuild[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
  @@index([targetPlatform])
  @@index([triggeredById])
  @@index([buildRunnerId])
  @@index([createdAt])
}

model PlayableBuild {
  id            String        @id @default(uuid())
  projectId     String
  buildJobId    String?
  milestoneId   String?
  version       String
  title         String
  platform      BuildPlatform
  storagePath   String?
  fileSizeBytes BigInt?
  fileChecksum  String?
  releaseNotes  String?       @db.Text
  uploadedById  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildJob      BuildJob?     @relation(fields: [buildJobId], references: [id], onDelete: SetNull)
  milestone     Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  uploadedBy    User?         @relation("UploadedPlayableBuilds", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([milestoneId])
  @@index([buildJobId])
  @@index([platform])
  @@index([version])
  @@index([createdAt])
}


